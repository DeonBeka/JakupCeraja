{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "^/(includes|database|api)(/.*)?$", "status": 404, "dest": "/api/index.php?__path=/404" },
    { "src": "^/$", "dest": "/api/index.php?__path=/index.php" },
    { "src": "^/admin/?$", "dest": "/api/index.php?__path=/admin/dashboard.php" },
    { "src": "^/(.+\\.php)$", "dest": "/api/index.php?__path=/$1" },
    { "handle": "filesystem" },
    { "src": "^/assets/(uploads|images/books)/(.*)$", "dest": "/api/index.php?__path=/assets/$1/$2" },
    { "src": "^/(.*)$", "status": 404, "dest": "/api/index.php?__path=/404" }
  ]
}
