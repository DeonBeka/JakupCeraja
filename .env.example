# Postgres (Neon). Leave empty locally to use a built-in local database (.pglite folder).
DATABASE_URL=

# Vercel Blob for uploaded images. Leave empty locally to save uploads in public/uploads/local.
BLOB_READ_WRITE_TOKEN=

# Signs the admin login cookie. Any long random text.
AUTH_SECRET=

# First admin login (used until a password is set in Admin → Cilësimet).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
